NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eduwins

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_very_secret_jwt_key_change_this_in_production

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
PAYSTACK_SPLIT_CODE=split_xxxxxxxxxxxx

# Frontend
FRONTEND_URL=http://localhost:3000

# Email Configuration
EMAIL_PROVIDER=test # options: brevo, gmail, test
BREVO_API_KEY=xkeysib_xxxxxxxxxxxx
EMAIL_FROM=noreply@eduwins.com
EMAIL_FROM_NAME=EduWins

# Email Nodemailer (for gmail provider)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-app-password

# Cloudflare R2 Configurations (S3-compatible bucket)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_CUSTOM_DOMAIN=https://your-public-domain-or-r2-dev-subdomain.com

